# Per-endpoint RSA public key (PEM) returned in the `public_key` field of the
# Bridge webhook create/update/enable API response.
# Store the single-line form with literal \n escapes — index.js converts them
# back to real newlines at load time.
BRIDGE_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# Optional: port to listen on (defaults to 3000)
PORT=3000
