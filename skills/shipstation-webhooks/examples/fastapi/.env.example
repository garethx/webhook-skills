# Unguessable token embedded in your webhook target URL (?token=...)
# ShipStation V1 has NO signing secret — this token secures the endpoint.
# Generate one with: openssl rand -hex 32
SHIPSTATION_WEBHOOK_SECRET=your_unguessable_random_token_here

# API credentials used to fetch the resource_url via HTTP Basic auth.
# ShipStation → Settings → Account → API Settings
SHIPSTATION_API_KEY=your_api_key_here
SHIPSTATION_API_SECRET=your_api_secret_here
