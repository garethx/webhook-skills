# macSecretBase64 returned ONCE when the webhook was created (POST /v0/bases/{baseId}/webhooks)
AIRTABLE_MAC_SECRET_BASE64=your_mac_secret_base64

# Personal Access Token used to fetch payloads from the webhook payloads API.
# Needs webhook:manage + data.records:read + schema.bases:read scopes.
AIRTABLE_PERSONAL_ACCESS_TOKEN=pat_xxx

# Optional: port to listen on (defaults to 3000)
PORT=3000
