# Which Volume public key to fetch: "sandbox" or "live".
#   sandbox -> https://api.sandbox.volumepay.io/.well-known/signature/pem
#   live    -> https://api.volumepay.io/.well-known/signature/pem
VOLUME_ENV=sandbox

# Optional: override the key URL entirely.
# VOLUME_PEM_URL=https://api.volumepay.io/.well-known/signature/pem

# Optional: a literal public key (bare base64 SPKI as Volume serves it, or a
# full PEM). When set, no network fetch happens.
# VOLUME_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...

PORT=3000
