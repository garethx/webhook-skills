# --- Supabase Auth Hooks (HTTP) --------------------------------------------
# Issued by Supabase: Dashboard -> Authentication -> Hooks -> your hook.
# Copy it INCLUDING the "v1,whsec_" prefix. The base64 portion is decoded to
# raw bytes to form the HMAC-SHA256 key.
SUPABASE_AUTH_HOOK_SECRET=v1,whsec_your_base64_secret_here

# --- Supabase Database Webhooks --------------------------------------------
# Supabase does NOT sign Database Webhooks and issues no secret for them.
# Generate your own (e.g. `openssl rand -base64 32`) and put the SAME value in
# the webhook's HTTP headers, e.g. {"Authorization":"Bearer <this value>"}.
SUPABASE_WEBHOOK_SECRET=generate_your_own_long_random_string
