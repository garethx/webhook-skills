# Tikkie API v2 notifications carry NO signature — there is no webhook secret.

# subscriptionId(s) returned (201) by POST /paymentrequestssubscription and/or
# POST /transactionssubscription. Comma-separate if both point at this endpoint.
# Unset => the subscriptionId check is skipped (a warning is logged).
TIKKIE_SUBSCRIPTION_ID=

# Used to re-fetch the authoritative record before fulfilling anything.
# API-Key: consumer key of your app on developer.abnamro.com
TIKKIE_API_KEY=
# X-App-Token: app token from the Tikkie Business Portal (or POST /sandboxapps)
TIKKIE_APP_TOKEN=
# Sandbox by default; production is https://api.abnamro.com/v2/tikkie
TIKKIE_API_BASE_URL=https://api-sandbox.abnamro.com/v2/tikkie

PORT=3000
