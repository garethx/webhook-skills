# Your Client ID from the Antom Dashboard (sandbox IDs are prefixed SANDBOX_)
ALIPAY_CLIENT_ID=SANDBOX_5YC47N2ZQHJ004124

# Antom / Alipay+ public key (from the Dashboard) — used to VERIFY inbound notifications.
# Store as a single line with literal \n between PEM lines.
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# Your merchant PRIVATE key — used to SIGN the acknowledgement response.
ALIPAY_MERCHANT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

# Optional: the keyVersion advertised in your response Signature header (default 1)
ALIPAY_KEY_VERSION=1

PORT=3000
