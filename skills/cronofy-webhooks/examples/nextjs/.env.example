# Your Cronofy application's OAuth CLIENT SECRET — this is the HMAC key.
#
# Cronofy does NOT issue a separate webhook signing secret. The same `CRN_`-prefixed
# client secret you use for the OAuth token exchange signs every push notification.
# It is NOT the client ID and NOT an access token.
#
# Find it in the Cronofy developer dashboard for your data centre, under your
# application's settings.
#
# During a secret rotation your application can have two active secrets. Cronofy
# signs each notification with every active secret and sends all the digests in one
# comma-separated Cronofy-HMAC-SHA256 header, so this receiver only needs whichever
# secret it currently holds.
#
# Server-side only — do NOT prefix with NEXT_PUBLIC_.
CRONOFY_CLIENT_SECRET=CRN_NggYusqPGLxwjw5FHOJYOqSrTPNXy8WQf14OID

# The data centre the Cronofy account belongs to. A `change` notification carries
# only `changes_since`, so you must call Read Events on this SAME host to fetch what
# actually changed.
#
#   https://api.cronofy.com      US
#   https://api-uk.cronofy.com   UK
#   https://api-de.cronofy.com   Germany
#   https://api-au.cronofy.com   Australia
#   https://api-ca.cronofy.com   Canada
#   https://api-sg.cronofy.com   Singapore
CRONOFY_DATA_CENTER_URL=https://api.cronofy.com
