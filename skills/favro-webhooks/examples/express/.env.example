# The secret you entered when creating the Favro webhook
FAVRO_WEBHOOK_SECRET=your_webhook_secret

# The postToUrl you registered with Favro, VERBATIM.
# This string is part of the signature — it must match byte-for-byte.
FAVRO_WEBHOOK_URL=https://example.com/webhooks/favro

# Port for the Express server (optional, defaults to 3000)
PORT=3000
