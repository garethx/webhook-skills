# OPTIONAL HTTP Basic Auth credentials, only if agreed with the Ethoca Customer
# Delivery Team at onboarding. If agreed, Ethoca sends them as:
#   Authorization: Basic base64(username:password)
# Leave both unset for an mTLS-only endpoint — the handler then skips the Basic
# Auth check and relies on mTLS instead of returning 401.
ETHOCA_WEBHOOK_USERNAME=your_basic_auth_username
ETHOCA_WEBHOOK_PASSWORD=your_basic_auth_password
