# Strava API application ID
STRAVA_CLIENT_ID=12345

# Strava API application secret
STRAVA_CLIENT_SECRET=your_client_secret_here

# Self-chosen token echoed during the subscription validation handshake
STRAVA_VERIFY_TOKEN=your_random_verify_token

# Optional: reject events not from this subscription (returned when you POST to
# /push_subscriptions). Leave unset to accept events from any subscription.
STRAVA_SUBSCRIPTION_ID=120475
