# Validation Key — verifies the SIGNATURE (SHA256). Primary check.
# Store Settings → General Settings → Integration (Validation Key)
PAYPRO_VALIDATION_KEY=your_validation_key

# Secret Key — verifies the HASH (MD5). Optional but recommended.
# Same dashboard tab, DIFFERENT key from the Validation Key above.
PAYPRO_SECRET_KEY=your_secret_key

# Optional: set to "true" to reject requests not from PayPro Global's fixed IPs.
# Prefer enforcing IP allowlisting at your firewall/load balancer instead.
PAYPRO_ENFORCE_IP=false

# Optional: port (defaults to 3000)
PORT=3000
