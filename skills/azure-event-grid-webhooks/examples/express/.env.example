# Azure Event Grid does NOT sign the request body. There is no signing secret,
# no HMAC key, and no signature header. Nothing below is an HMAC key.

# --- Identity guard (required to complete the validation handshake) ---
# The event subscription name(s) you created, comma-separated. Compared against
# the `aeg-subscription-name` header. Without this, anyone who learns your URL
# could point their own event subscription at it and self-validate.
AZURE_EVENT_GRID_SUBSCRIPTION_NAMES=my-webhook-subscription

# --- Channel authentication, option A: static delivery property (shared secret) ---
# Configure the same header + value on the event subscription:
#   az eventgrid event-subscription create ... \
#     --delivery-attribute-mapping x-eventgrid-token static "<secret>" true
# NEVER name a custom header with the reserved `aeg-` prefix.
AZURE_EVENT_GRID_DELIVERY_SECRET_HEADER=x-eventgrid-token
AZURE_EVENT_GRID_DELIVERY_SECRET=

# --- Channel authentication, option C: client secret as a QUERY PARAMETER ---
# Documented at learn.microsoft.com/en-us/azure/event-grid/security-authentication.
# Append the secret to the subscription's endpoint URL; Event Grid replays every
# query parameter on every delivery. Azure stores these encrypted and keeps them
# out of service logs (read them back with `--include-full-endpoint-url`).
#   --endpoint "https://example.com/webhooks/azure-event-grid?token=<secret>"
# Comma-separate to accept BOTH the old and new secret during rotation — without
# an overlap window, deliveries fail between rotating and updating the subscription.
AZURE_EVENT_GRID_QUERY_SECRET_PARAM=token
AZURE_EVENT_GRID_QUERY_SECRET=

# --- Channel authentication, option B: Microsoft Entra ID protected endpoint ---
# Set when the subscription uses --azure-active-directory-tenant-id and
# --azure-active-directory-application-id-or-uri. The bearer token arrives in
# the standard Authorization header and is validated as a normal Entra JWT.
AZURE_EVENT_GRID_ENTRA_TENANT_ID=
AZURE_EVENT_GRID_ENTRA_AUDIENCE=

# --- CloudEvents v1.0 abuse-protection preflight (HTTP OPTIONS) ---
# Allowed `WebHook-Request-Origin` values, comma-separated. `*` grants all.
AZURE_EVENT_GRID_ALLOWED_ORIGINS=*
# Permitted requests per minute, returned as `WebHook-Allowed-Rate`.
AZURE_EVENT_GRID_ALLOWED_RATE=120

# --- Local development escape hatch ---
# Accept requests with no delivery credential. NEVER set this in production.
AZURE_EVENT_GRID_ALLOW_UNAUTHENTICATED=false

# Port the server listens on
PORT=3000
