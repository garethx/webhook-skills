# Trello OAuth 1.0 application secret (Power-Up management page -> API Key tab)
TRELLO_SECRET=your_trello_oauth1_application_secret

# The exact callback URL registered when the webhook was created.
# Trello concatenates this to the request body before signing, so it must match
# byte-for-byte (scheme, host, path, any query string).
TRELLO_CALLBACK_URL=https://example.com/webhooks/trello

# Optional: port the server listens on (defaults to 3000)
PORT=3000
