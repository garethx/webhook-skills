# The per-WebHook "HMAC Key" from the Formstack form's WebHook submit action.
#
# Find it in: Form Settings > Emails & Actions > Advanced Settings > Add Webhook
# (or edit an existing one), in the "HMAC Key" field. Via the v2025 API it is the
# `hmacSecret` field on the webhook object.
#
# IMPORTANT:
#   - Signing is OPTIONAL and OFF BY DEFAULT. Formstack sends NO signature at all
#     unless this key is set on the WebHook. Setting it is the first setup step.
#   - There is NO account-wide webhook secret. Each WebHook on each form can have
#     its own key.
#   - This is NOT the V2 API application client secret, an access token, or a
#     Personal Access Token. Those authenticate the management API; this signs
#     deliveries. Keep them separate.
#
# This example FAILS CLOSED: if this is unset or empty, every delivery is rejected.
FORMSTACK_HMAC_KEY=your_webhook_hmac_key

# Header carrying the HMAC digest.
#
# `x-fs-signature` is the DEFAULT. The Formstack help article: "If left blank,
# X-FS-Signature will be used as the HMAC header." The WebHook's "Custom HMAC Header"
# field overrides it, so only change this if that field is filled in.
#
# Lowercase — Express, Next.js and FastAPI all expose headers lowercased, and HTTP
# header names are case-insensitive.
FORMSTACK_SIGNATURE_HEADER=x-fs-signature

# Port for the FastAPI server
PORT=8000
