# Your BigCommerce app's client secret — used to verify webhook signatures.
# Find it in the Developer Portal under your app's API credentials.
BIGCOMMERCE_CLIENT_SECRET=your_client_secret_here

# Needed only to call the REST API back for full resource details.
# Webhook payloads are thin ({ type, id }); fetch the resource with these.
# BIGCOMMERCE_STORE_HASH=abc123
# BIGCOMMERCE_ACCESS_TOKEN=your_access_token_here
