# --- Authenticated push subscription (recommended) ---
# The subscription's OIDC audience. If the subscription was created WITHOUT
# --push-auth-token-audience, this is the full push endpoint URL (scheme, host,
# path, and query string) and must match byte for byte.
PUBSUB_AUDIENCE=https://example.com/webhooks/google-pubsub

# The service account passed to --push-auth-service-account. Checked against the
# token's `email` claim. Without this check, any Google-signed token with the
# right audience would be accepted.
PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@my-project.iam.gserviceaccount.com

# --- Fallback for subscriptions that cannot use OIDC ---
# Unguessable token embedded in the push endpoint URL (?token=...), compared
# server-side. A DIY convention, NOT a Google-defined signature scheme.
PUBSUB_VERIFICATION_TOKEN=

# --- Optional hardening ---
# If set, envelopes whose `subscription` field does not match are rejected (403).
PUBSUB_SUBSCRIPTION=projects/my-project/subscriptions/my-sub

# The Pub/Sub emulator sends no Authorization header. Set to true ONLY for local
# emulator testing — never in production.
PUBSUB_ALLOW_UNAUTHENTICATED=false
