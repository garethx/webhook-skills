# BaseLinker sends NO signature, NO secret, and NO handshake. There is no
# signing key to configure here — anything named BASELINKER_WEBHOOK_SECRET would
# be fiction. See the skill's references/verification.md.

# Your BaseLinker API token (Account settings -> API). Sent as the X-BLToken
# REQUEST header on YOUR outbound calls to api.baselinker.com, e.g. to fetch the
# order after a callback. It is NOT a webhook signature and never arrives on an
# inbound delivery.
BASELINKER_API_TOKEN=your_api_token

# OPTIONAL. A random token YOU append to the endpoint URL registered in
# BaseLinker's Automatic Actions, e.g.
#   https://your-app.example.com/webhooks/baselinker?order_id=[order_id]&token=RANDOM
# The [order_id] form is ILLUSTRATIVE — BaseLinker documents no URL-calling
# action and no placeholder/macro syntax, so substitute whatever placeholder your
# panel offers.
# The handler compares the `token` query param against this value with a
# timing-safe comparison. This is YOUR secret round-tripped back to you — not
# provider authentication — and it is visible in the URL. Leave empty to skip.
BASELINKER_URL_TOKEN=
