{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }]
  },
  "include": ["app", "test", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
