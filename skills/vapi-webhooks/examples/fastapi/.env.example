# The shared secret your Vapi Server URL credential sends. Bearer Token
# credential → `Authorization: Bearer <token>`; legacy credential / old inline
# server.secret → `X-Vapi-Secret: <token>`. The handler compares it with a
# timing-safe comparison. Vapi has NO fixed HMAC signature scheme.
VAPI_WEBHOOK_SECRET=your_shared_secret

# Optional: assistant to return for an inbound `assistant-request`.
VAPI_ASSISTANT_ID=your_assistant_id

# Optional: fallback number for a `transfer-destination-request`.
VAPI_TRANSFER_NUMBER=+15551234567
