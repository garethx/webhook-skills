# The shared secret your Vapi Server URL credential sends. With a Bearer Token
# credential Vapi sends `Authorization: Bearer <token>`; with the legacy
# credential (or the old inline server.secret field) it sends `X-Vapi-Secret:
# <token>`. Set this to that token — the handler compares it with a timing-safe
# comparison. Vapi has NO fixed HMAC signature scheme.
VAPI_WEBHOOK_SECRET=your_shared_secret

# Optional: the assistant to return for an inbound `assistant-request`.
VAPI_ASSISTANT_ID=your_assistant_id

# Optional: fallback number for a `transfer-destination-request`.
VAPI_TRANSFER_NUMBER=+15551234567
