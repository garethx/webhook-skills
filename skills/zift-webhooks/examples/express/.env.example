# Zift sends NO signing secret and NO auth header on webhook deliveries, so there
# is no secret to configure here. Authenticity relies on HTTPS + endpoint-URL
# secrecy, optionally reinforced with IP allowlisting.
#
# Optional: Zift egress IP ranges to allow (confirm with Zift support).
# Enforcement belongs at your load balancer / firewall — this is informational.
ZIFT_ALLOWED_IPS=

# Optional: port for the example server (defaults to 3000).
PORT=3000
