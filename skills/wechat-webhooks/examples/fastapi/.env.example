# Recommended: WeChat Pay platform public keys (PEM) keyed by certificate serial,
# as a JSON object. The Wechatpay-Serial header selects which one verifies a
# notification. WeChat publishes new certificates ~24h before signing with them,
# so refresh this from GET /v3/certificates (e.g. every 12h) and keep both the
# outgoing and incoming serials present through a rotation.
WECHAT_PAY_PLATFORM_KEYS='{"serial_a":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","serial_b":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}'

# Single-key alternative (folded into the map above when both are set).
# Use \n for line breaks if storing the PEM on a single line.
WECHAT_PAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 32-character APIv3 key used to decrypt resource.ciphertext (AES-256-GCM).
WECHAT_PAY_API_V3_KEY=your_32_character_apiv3_key_here

# Serial for the single key above (matched against Wechatpay-Serial).
WECHAT_PAY_PLATFORM_SERIAL=your_platform_cert_serial
