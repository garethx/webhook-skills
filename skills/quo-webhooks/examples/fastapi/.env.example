# ---------------------------------------------------------------------------
# Quo (formerly OpenPhone) webhook secrets
#
# Quo has TWO webhook generations with TWO different signature schemes. Which
# one your endpoint receives is decided by how the subscription was created —
# you cannot choose it here. Set the secret(s) for the scheme(s) you actually
# use; this example fails closed on anything it cannot verify.
#
# This is NOT Quoter (the CPQ company, MD5 `hash` form field). Different
# company, different scheme.
# ---------------------------------------------------------------------------

# SCHEME A — current API (Quo-Api-Version: 2026-03-30).
#
# The `key` field returned by POST https://api.quo.com/webhooks. Copy it
# straight into your secret store at creation time — the docs don't say it can
# be re-read later, and if you lose it you have to rotate.
#
# Store it EXACTLY as returned, including the whsec_ prefix. The code strips the
# prefix and base64-decodes the remainder to get the raw HMAC key bytes; passing
# the whsec_ string into createHmac is a bug (only the Svix SDK accepts it).
#
# Rotate with POST /webhooks/{webhookId}/rotate.
QUO_WEBHOOK_KEY=whsec_c2VjcmV0

# SCHEME B — legacy v1 webhooks only.
#
# From the Quo app: open the webhook's details page -> the ellipses (...) ->
# "Reveal signing secret". It is a BASE64-ENCODED string with NO whsec_ prefix,
# and the code base64-decodes it to raw bytes before use.
#
# This is NOT your Quo API key. The API key authenticates you calling Quo; this
# secret verifies Quo calling you.
#
# Leave unset if all your webhooks were created against the versioned API.
QUO_LEGACY_SIGNING_SECRET=R2ZLM2o0bFhBNVpyUnU2NG9mYXQ1MHNyR3pvSUhIVVg=

# Replay tolerance in seconds, applied to both schemes (optional; default 300).
#
# Both Quo schemes put a timestamp in the signed content, so a real staleness
# check is possible on both. Quo's own signature-validation example uses 5
# minutes. Note the units DIFFER on the wire — Scheme A's webhook-timestamp is
# UNIX seconds, the legacy timestamp is UNIX milliseconds — but this value is
# always expressed in seconds and the code handles the conversion.
QUO_MAX_AGE_SECONDS=300

# Port for the uvicorn server
PORT=8000
