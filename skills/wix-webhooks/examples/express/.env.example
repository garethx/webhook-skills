# Your Wix App ID — from the OAuth page of your app dashboard
WIX_APP_ID=your-app-id

# Your app's public key — App Dashboard > Webhooks > "Get Public Key"
# (or More Actions > View ID & keys). Keep the PEM on one line with \n escapes.
# @wix/sdk also accepts a base64-encoded PEM.
WIX_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----"

# Optional: port the server listens on (defaults to 3000)
PORT=3000
