# The per-webhook Signing Secret MailerSend generates when the webhook is
# created. Find it on the webhook management page:
#   Email -> Domains -> Manage -> Webhooks -> your webhook
#
# This is NOT your MailerSend API token (mlsn....). Each webhook has its own
# signing secret; two webhooks on the same domain do not share one.
#
# No NEXT_PUBLIC_ prefix — this is a server-only secret and must never reach the
# browser bundle.
MAILERSEND_WEBHOOK_SECRET=your_webhook_signing_secret

# Note: MailerSend's `webhook.test` URL-validation ping is signed with a FIXED,
# publicly documented secret (test_Am3L1GuOIc4blLUuHqAPxxwkZaJyEk8G), not the
# value above. It is a constant in the route handler, not an environment
# variable — it is public, so it is not a credential.
