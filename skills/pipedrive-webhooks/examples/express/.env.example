# HTTP Basic Auth credentials you set on the webhook (http_auth_user / http_auth_password).
# Pipedrive sends these on every delivery; your handler verifies them.
PIPEDRIVE_WEBHOOK_USER=my-webhook-user
PIPEDRIVE_WEBHOOK_PASSWORD=a-long-random-secret

# Only needed to register a webhook via the API (node register-webhook.js):
PIPEDRIVE_API_TOKEN=your-pipedrive-api-token
PIPEDRIVE_SUBSCRIPTION_URL=https://your-app.com/webhooks/pipedrive

# Optional
PORT=3000
