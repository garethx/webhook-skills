# Lithic webhook signing secret (per-subscription, starts with whsec_).
# Copy it from the Lithic Dashboard when you create the event subscription.
LITHIC_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Lithic API key. Only needed to call the Lithic API; webhook verification uses
# the signing secret above. A placeholder is fine for a receive-only endpoint.
LITHIC_API_KEY=your_api_key_here
