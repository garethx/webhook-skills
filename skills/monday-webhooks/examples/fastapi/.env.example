# monday.com app "Signing Secret" (board/integration webhooks).
# Use the app "Client Secret" instead for app lifecycle webhooks.
# Find both in Developer Center -> your app -> Basic Information.
MONDAY_SIGNING_SECRET=your_signing_secret_here

# Optional: the endpoint URL monday.com was configured with.
# Set this to enforce the JWT "aud" (audience) claim in production.
# MONDAY_WEBHOOK_URL=https://your-app.com/webhooks/monday
