# Oura client secret — the HMAC key for the x-oura-signature header
OURA_CLIENT_SECRET=your_client_secret_here

# Verification token you chose when creating the subscription (used in the GET handshake)
OURA_VERIFICATION_TOKEN=your_verification_token_here

# Client ID — only needed if this app also manages subscriptions via the API
OURA_CLIENT_ID=your_client_id_here
