# Circle API key — used to fetch the notification public key by keyId.
# Get it from the Circle console: Developer > API Keys (app.circle.com).
CIRCLE_API_KEY=your_circle_api_key_here

# Circle API base URL.
#   Production: https://api.circle.com
#   Sandbox:    https://api-sandbox.circle.com
CIRCLE_API_BASE_URL=https://api.circle.com
