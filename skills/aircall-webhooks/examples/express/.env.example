# Aircall webhook token — the `token` field returned by POST /v1/webhooks
# (response shape: { "webhook": { "webhook_id": "...", "token": "...", ... } })
#
# This is NOT your API key. Aircall verifies webhooks by putting this exact
# string in the `token` field of every event body — there is no signature header.
#
# Created the webhook from the Aircall Dashboard? The UI does not show the token.
# Fetch it with: GET https://api.aircall.io/v1/webhooks/{webhook_id}
AIRCALL_WEBHOOK_TOKEN=df76g76dpziygs567f0

# Port for the Express server
PORT=3000
