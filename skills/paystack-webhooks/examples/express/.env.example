# Paystack secret key — used to verify webhook signatures (HMAC-SHA512).
# This is the same key you use for API calls. Get it from
# Dashboard → Settings → API Keys & Webhooks. Test mode and live mode differ.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: port the server listens on (defaults to 3000)
PORT=3000
