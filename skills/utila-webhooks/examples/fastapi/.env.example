# Utila's PEM-encoded RSA-4096 PUBLIC key (Console -> Vault Settings -> Webhooks).
# There is no shared secret — verification uses only this public key.
# Multi-line PEM: store with real newlines, or on one line with escaped \n.
UTILA_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8A...\n-----END PUBLIC KEY-----\n"
