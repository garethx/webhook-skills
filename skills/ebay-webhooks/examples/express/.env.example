# eBay verification token you generate (32-80 chars, only A-Z a-z 0-9 _ -).
# Must match the token you enter in the eBay Developer Portal / createDestination.
EBAY_VERIFICATION_TOKEN=your_verification_token_change_me_012345

# The EXACT public HTTPS URL eBay calls. Used in the SHA-256 challenge hash, so
# it must match character-for-character (scheme + host + path).
EBAY_ENDPOINT=https://your-domain.com/webhooks/ebay

# Application keyset credentials (used to fetch the public key via getPublicKey).
EBAY_CLIENT_ID=your_app_id_client_id
EBAY_CLIENT_SECRET=your_cert_id_client_secret

# sandbox | production  (selects api.sandbox.ebay.com vs api.ebay.com)
EBAY_ENV=production

# Optional: local server port (default 3000)
PORT=3000
