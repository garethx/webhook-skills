# Community webhook signature secret (unique per webhook)
# Community Dashboard → Settings → Integrations → Webhooks → Configure → signature secret
# NOTE: this is NOT your community_api-prefixed Async REST API bearer token.
COMMUNITY_WEBHOOK_SECRET=your_signature_secret_here

# Optional replay/staleness hardening. Community documents NO tolerance window,
# so this is disabled (0) by default. If you enable it, keep the window well
# above 3600 — Community retries a failed delivery for up to an hour.
COMMUNITY_WEBHOOK_TOLERANCE_SECONDS=0

# Port the example server listens on
PORT=3000
